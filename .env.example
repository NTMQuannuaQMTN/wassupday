# Copy this file to .env.local and fill in the values from your Supabase project:
#   Supabase Dashboard -> Project Settings -> Data API / API Keys
#
# Only EXPO_PUBLIC_-prefixed vars are bundled into the app. These two are safe to
# ship in the client: data access is protected by Row Level Security, not by
# keeping the key secret.
#
# NEVER put the service-role key (or any other secret) in this file or anywhere
# in the mobile app.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
